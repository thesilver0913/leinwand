+
+// Draw the indicators as an item inside the window being hovered instead of in a
+// translucent top-level window. Wayland requires it; elsewhere it is for setups
+// where translucent windows do not work (e.g. Qt Quick on Vulkan on Windows).
+static bool useOverlayItem()
+{
+    return isWayland()
+        || (Config::self().internalFlags() & Config::InternalFlag_DisableTranslucency);
+}
 }
 
 ClassicDropIndicatorOverlay::ClassicDropIndicatorOverlay(Core::ClassicDropIndicatorOverlay *classicIndicators, Core::View *parent)
     : QObject(QtQuick::asView_qtquick(parent))
     , m_classicIndicators(classicIndicators)
-    , m_window(isWayland() ? nullptr : new IndicatorWindow())
+    , m_window(useOverlayItem() ? nullptr : new IndicatorWindow())
 {
     Q_ASSERT(parent);
     classicIndicators->dptr()->hoveredGroupRectChanged.connect([this] { hoveredGroupRectChanged(); });
     classicIndicators->dptr()->currentDropLocationChanged.connect([this] { currentDropLocationChanged(); });
 
-    if (isWayland()) {
+    if (useOverlayItem()) {
         auto subContext = new QQmlContext(plat()->qmlEngine()->rootContext(), this);
         subContext->setContextProperty(QStringLiteral("_kddw_overlayWindow"), this);
         m_overlayItem = QtQuick::View::createItem(qmlSouceUrl().toString(), QtQuick::asView_qtquick(parent), subContext);
@@ -243,6 +254,11 @@ void IndicatorWindow::setQuickWindowCreationCallback(const IndicatorWindowCreati
 
 QUrl ClassicDropIndicatorOverlay::qmlSouceUrl() const
 {
+    if (auto factory = qobject_cast<QtQuick::ViewFactory *>(Config::self().viewFactory())) {
+        const QUrl url = factory->classicIndicatorsOverlayFilename();
+        if (!url.isEmpty())
+            return url;
+    }
 #ifdef KDDW_QML_MODULE
     return QUrl(QStringLiteral("qrc:/qt/qml/com/kdab/dockwidgets/ClassicIndicatorsOverlay.qml"));
 #else
